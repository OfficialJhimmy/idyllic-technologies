# Public (safe for the browser)
# Local development: http://localhost:3000 and http://shop.localhost:3000. Set the real domains on Vercel.
NEXT_PUBLIC_SITE_URL=https://idyllictechnologies.com
NEXT_PUBLIC_SHOP_URL=https://shop.idyllictechnologies.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GA_ID=
# TODO: confirm with Idyllic before launch. Digits only, no plus sign.
NEXT_PUBLIC_WHATSAPP_NUMBER=2347037973666

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Local work and migrations: the Session pooler (port 5432, allows only 15 connections in total).
# Deployed app on Vercel: use the Transaction pooler (port 6543) so many serverless instances can share it.
DATABASE_URL=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
REVALIDATE_SECRET=

# Contact form email (optional). Without RESEND_API_KEY enquiries are still saved to the admin inbox.
# CONTACT_FROM_EMAIL must be an address on a domain verified in Resend, for example "Idyllic Technologies <enquiries@idyllictechnologies.com>".
CONTACT_FROM_EMAIL=
# Defaults to the contact email in the admin settings values.
CONTACT_TO_EMAIL=
